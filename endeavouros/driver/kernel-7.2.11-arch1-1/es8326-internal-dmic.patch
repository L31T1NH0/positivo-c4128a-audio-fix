+/* Caller holds es8326->lock, including the jack worker and control put. */
+static int es8326_apply_adc_sources(struct es8326_priv *es8326,
+				    unsigned int source1, unsigned int source2)
+{
+	struct reg_sequence sources[] = {
+		{ ES8326_ADC1_SRC, source1 },
+		{ ES8326_ADC2_SRC, source2 },
+	};
+
+	if (es8326->force_internal_dmic) {
+		sources[0].def = 0x44;
+		sources[1].def = 0x66;
+	}
+
+	return regmap_multi_reg_write(es8326->regmap, sources, ARRAY_SIZE(sources));
+}
+
+static int es8326_internal_dmic_get(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es8326_priv *es8326 = snd_soc_component_get_drvdata(component);
+
+	mutex_lock(&es8326->lock);
+	ucontrol->value.integer.value[0] = es8326->force_internal_dmic;
+	mutex_unlock(&es8326->lock);
+	return 0;
+}
+
+static int es8326_internal_dmic_put(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es8326_priv *es8326 = snd_soc_component_get_drvdata(component);
+	bool enabled, previous;
+	unsigned int source1 = 0x44, source2 = 0x66;
+	int ret;
+
+	if (ucontrol->value.integer.value[0] < 0 ||
+	    ucontrol->value.integer.value[0] > 1)
+		return -EINVAL;
+	enabled = ucontrol->value.integer.value[0];
+
+	mutex_lock(&es8326->lock);
+	previous = es8326->force_internal_dmic;
+	es8326->force_internal_dmic = enabled;
+	if (!enabled && es8326->jack &&
+	    (es8326->jack->status & SND_JACK_MICROPHONE)) {
+		source1 = 0x00;
+		source2 = 0x00;
+	}
+	ret = es8326_apply_adc_sources(es8326, source1, source2);
+	if (ret)
+		es8326->force_internal_dmic = previous;
+	mutex_unlock(&es8326->lock);
+	return ret ? ret : previous != enabled;
+}
+
